SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Workspace user the app acts as in Drive (needs domain-wide delegation)
GOOGLE_IMPERSONATE_USER=
# Optional, defaults to "Mentoring"
GOOGLE_DRIVE_MENTORING_SUBFOLDER=
RESEND_API_KEY=
EMAIL_FROM=Upbuild Mentoring <mentoring@upbuild.com>
APP_URL=http://localhost:3000
ADMIN_PASSWORD=
PORT=3000

# Private Supabase Storage bucket holding the ICF forms and reference guides (default icf-reference; kept out of this public repo)
ICF_REFERENCE_BUCKET=
# Optional: OpenAI model for drafting the ICF form (default gpt-5.5)
ICF_MODEL=
# Optional: AI thinking level for ICF drafts (default medium; high is slower and costs more)
ICF_REASONING_EFFORT=
